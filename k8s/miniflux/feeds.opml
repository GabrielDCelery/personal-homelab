<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tech radar starter feeds, one Miniflux category per topic. Imported by
  `mise run miniflux:import-feeds`. Re-importing is safe: Miniflux skips feed URLs it
  already has and reuses existing categories by title.
-->
<opml version="2.0">
  <head>
    <title>Tech radar</title>
  </head>
  <body>
    <outline text="architecture" title="architecture">
      <outline type="rss" text="InfoQ" title="InfoQ" xmlUrl="https://feed.infoq.com/" htmlUrl="https://www.infoq.com/"/>
      <outline type="rss" text="The Pragmatic Engineer" title="The Pragmatic Engineer" xmlUrl="https://newsletter.pragmaticengineer.com/feed" htmlUrl="https://newsletter.pragmaticengineer.com/"/>
      <outline type="rss" text="ByteByteGo" title="ByteByteGo" xmlUrl="https://blog.bytebytego.com/feed" htmlUrl="https://blog.bytebytego.com/"/>
      <outline type="rss" text="Martin Fowler" title="Martin Fowler" xmlUrl="https://martinfowler.com/feed.atom" htmlUrl="https://martinfowler.com/"/>
      <outline type="rss" text="Netflix Tech Blog" title="Netflix Tech Blog" xmlUrl="https://netflixtechblog.com/feed" htmlUrl="https://netflixtechblog.com/"/>
    </outline>
    <outline text="devops" title="devops">
      <outline type="rss" text="CNCF Blog" title="CNCF Blog" xmlUrl="https://www.cncf.io/feed/" htmlUrl="https://www.cncf.io/blog/"/>
      <outline type="rss" text="Kubernetes Blog" title="Kubernetes Blog" xmlUrl="https://kubernetes.io/feed.xml" htmlUrl="https://kubernetes.io/blog/"/>
      <outline type="rss" text="Kubernetes Releases" title="Kubernetes Releases" xmlUrl="https://github.com/kubernetes/kubernetes/releases.atom" htmlUrl="https://github.com/kubernetes/kubernetes/releases"/>
      <outline type="rss" text="HashiCorp Blog" title="HashiCorp Blog" xmlUrl="https://www.hashicorp.com/blog/feed.xml" htmlUrl="https://www.hashicorp.com/blog"/>
      <outline type="rss" text="SRE Weekly" title="SRE Weekly" xmlUrl="https://sreweekly.com/feed/" htmlUrl="https://sreweekly.com/"/>
      <outline type="rss" text="The New Stack" title="The New Stack" xmlUrl="https://thenewstack.io/feed/" htmlUrl="https://thenewstack.io/"/>
    </outline>
    <outline text="networking" title="networking">
      <outline type="rss" text="Cloudflare Blog" title="Cloudflare Blog" xmlUrl="https://blog.cloudflare.com/rss/" htmlUrl="https://blog.cloudflare.com/"/>
      <outline type="rss" text="APNIC Blog" title="APNIC Blog" xmlUrl="https://blog.apnic.net/feed/" htmlUrl="https://blog.apnic.net/"/>
      <outline type="rss" text="ipSpace.net" title="ipSpace.net" xmlUrl="https://blog.ipspace.net/atom.xml" htmlUrl="https://blog.ipspace.net/"/>
      <outline type="rss" text="Packet Pushers" title="Packet Pushers" xmlUrl="https://packetpushers.net/feed/" htmlUrl="https://packetpushers.net/"/>
      <outline type="rss" text="RIPE Labs" title="RIPE Labs" xmlUrl="https://labs.ripe.net/rss/" htmlUrl="https://labs.ripe.net/"/>
      <outline type="rss" text="Tailscale Blog" title="Tailscale Blog" xmlUrl="https://tailscale.com/blog/index.xml" htmlUrl="https://tailscale.com/blog"/>
    </outline>
    <outline text="ai" title="ai">
      <outline type="rss" text="Simon Willison" title="Simon Willison" xmlUrl="https://simonwillison.net/atom/everything/" htmlUrl="https://simonwillison.net/"/>
      <outline type="rss" text="Latent Space" title="Latent Space" xmlUrl="https://www.latent.space/feed" htmlUrl="https://www.latent.space/"/>
      <outline type="rss" text="Import AI" title="Import AI" xmlUrl="https://importai.substack.com/feed" htmlUrl="https://importai.substack.com/"/>
      <outline type="rss" text="Hugging Face Blog" title="Hugging Face Blog" xmlUrl="https://huggingface.co/blog/feed.xml" htmlUrl="https://huggingface.co/blog"/>
      <outline type="rss" text="OpenAI News" title="OpenAI News" xmlUrl="https://openai.com/news/rss.xml" htmlUrl="https://openai.com/news/"/>
      <outline type="rss" text="Google DeepMind" title="Google DeepMind" xmlUrl="https://deepmind.google/blog/rss.xml" htmlUrl="https://deepmind.google/discover/blog/"/>
      <outline type="rss" text="Interconnects" title="Interconnects" xmlUrl="https://www.interconnects.ai/feed" htmlUrl="https://www.interconnects.ai/"/>
    </outline>
    <outline text="aws" title="aws">
      <outline type="rss" text="AWS News Blog" title="AWS News Blog" xmlUrl="https://aws.amazon.com/blogs/aws/feed/" htmlUrl="https://aws.amazon.com/blogs/aws/"/>
      <outline type="rss" text="AWS What's New" title="AWS What's New" xmlUrl="https://aws.amazon.com/about-aws/whats-new/recent/feed/" htmlUrl="https://aws.amazon.com/new/"/>
    </outline>
  </body>
</opml>
